      "updated": 1794768000000,
      "link": null,
      "locked": false,
      "text": "Anatomie optique CSS GPU (0 % CPU, ClearType intact) :\n• Couche OS : win.setBackgroundMaterial('acrylic') + #00000000\n• Surface vitrée : hsl(var(--card) / alpha) + backdrop-filter: blur(18px) saturate(145%)\n• Halo interne givré : inset 0 0 22px -4px rgba(255,255,255,0.12) + hsl(var(--primary)/0.20)\n• Reflets spéculaires : inset 1px 1px 0 rgba(255,255,255,0.48) (haut-gauche)\n                        + inset -1px -1px 0 hsl(var(--primary)/0.38) (bas-droite)",
      "originalText": "Anatomie optique CSS GPU (0 % CPU, ClearType intact) :\n• Couche OS : win.setBackgroundMaterial('acrylic') + #00000000\n• Surface vitrée : hsl(var(--card) / alpha) + backdrop-filter: blur(18px) saturate(145%)\n• Halo interne givré : inset 0 0 22px -4px rgba(255,255,255,0.12) + hsl(var(--primary)/0.20)\n• Reflets spéculaires : inset 1px 1px 0 rgba(255,255,255,0.48) (haut-gauche)\n                        + inset -1px -1px 0 hsl(var(--primary)/0.38) (bas-droite)",
      "fontSize": 12,
